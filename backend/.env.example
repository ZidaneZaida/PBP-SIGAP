# Django
SECRET_KEY=dev-insecure-ganti-di-produksi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supavisor SESSION pooler di produksi, Postgres lokal saat dev
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sigap
CONN_MAX_AGE=0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (Flutter Web)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUM_PROXIES=1

# FCM (opsional saat dev)
FIREBASE_CREDENTIALS_JSON=

# Email — Brevo port 2525 (port 465/587 diblokir Render)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGAP <no-reply@sigap.app>

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Endpoint internal
INTERNAL_SYNC_TOKEN=