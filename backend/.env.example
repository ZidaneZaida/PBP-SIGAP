# =============================================================================
# TEMPLATE ENVIRONMENT VARIABLES — SIGAP Backend
# =============================================================================
# Salin file ini menjadi .env untuk penggunaan lokal, atau gunakan sebagai
# panduan untuk mengisi Environment Variables di dashboard Render.com.
# JANGAN PERNAH commit file .env asli Anda ke Git repository!

# ---------------------------------------------------------------------------
# DJANGO CORE
# ---------------------------------------------------------------------------
SECRET_KEY=dev-insecure-ganti-di-produksi-dengan-string-acak-panjang
DEBUG=True

# Host yang diizinkan mengakses API (pisahkan koma)
# Default sudah mengizinkan: localhost, 127.0.0.1, dan domain .onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# DATABASE — Pilih salah satu sesuai kebutuhan:
# ---------------------------------------------------------------------------

# [OPSI 1] SQLite lokal — Cocok untuk development di komputer sendiri:
DATABASE_URL=sqlite:///db.sqlite3
CONN_MAX_AGE=0
ALLOW_REMOTE_TESTS=

# [OPSI 2] Neon Serverless Postgres (neon.tech) — DIREKOMENDASIKAN untuk Produksi / Render:
# Ambil dari: Dashboard Neon -> Project -> Dashboard -> Connection Details
# Pilih dropdown "Pooled connection" (hostname berakhiran -pooler)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
#
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sweet-glade-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# CONN_MAX_AGE=60
# CONN_HEALTH_CHECKS=True
# ALLOW_REMOTE_TESTS=True

# [OPSI 3] Supabase Session Pooler (PostgreSQL):
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# CONN_MAX_AGE=60
# ALLOW_REMOTE_TESTS=True

# [OPSI 3] PostgreSQL lokal via Conda (port 5432):
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/sigap

TEST_DB_NAME=

# ---------------------------------------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# FRONTEND & CORS
# ---------------------------------------------------------------------------
# URL Web Frontend (untuk tautan reset password & redirect)
FRONTEND_BASE_URL=http://localhost:3000

# CORS — Domain web yang diizinkan memanggil REST API (pisahkan koma)
# Tambahkan URL Render Web atau domain live Flutter Web Anda di sini
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUM_PROXIES=1

# ---------------------------------------------------------------------------
# PUSH NOTIFICATION & EXTERNAL SERVICES (Opsional)
# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (JSON credentials satu baris, kosongkan bila belum ada)
FIREBASE_CREDENTIALS_JSON=

# Email Brevo (port 2525). Bila kosong, Django mengirim email ke console terminal.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGAP <no-reply@sigap.app>

# Supabase Storage (Upload foto profil)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_AVATARS=avatars

# Internal sync token
INTERNAL_SYNC_TOKEN=
