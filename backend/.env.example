# =============================================================================
# TEMPLATE ENVIRONMENT VARIABLES — SIGAP Backend (Neon Postgres)
# =============================================================================
SECRET_KEY=ganti-dengan-secret-key-acak-panjang
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Neon Serverless Postgres)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sweet-glade-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
CONN_MAX_AGE=60
CONN_HEALTH_CHECKS=True
ALLOW_REMOTE_TESTS=True

# CORS & Reverse Proxy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUM_PROXIES=1

# Object storage (foto avatar & laporan kerusakan SIGAP-Vision)
# Kosongkan bila belum dipakai; unggahan foto akan dilewati dengan aman.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_DAMAGE=damage-reports
