# Django
SECRET_KEY=dev-insecure-ganti-di-produksi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supabase SESSION POOLER (port 5432). JANGAN port 6543.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
CONN_MAX_AGE=0

# Testing — isi bila project test berbeda dari DATABASE_URL
TEST_DB_NAME=
# Wajib true bila DATABASE_URL menunjuk host remote (Supabase)
ALLOW_REMOTE_TESTS=True

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend (tautan reset password)
FRONTEND_BASE_URL=http://localhost:3000

# CORS (Flutter Web)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUM_PROXIES=1

# FCM — bila kosong, push notification dilewati
FIREBASE_CREDENTIALS_JSON=

# Email — Brevo port 2525. Bila EMAIL_HOST_USER kosong, email ke console.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGAP <no-reply@sigap.app>

# Supabase Storage (foto profil)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_AVATARS=avatars

# Internal
INTERNAL_SYNC_TOKEN=
